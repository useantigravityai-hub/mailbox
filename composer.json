{
    "name": "eibs/laravel-gmail-mailbox",
    "description": "A reusable Laravel package for Gmail API integration, OAuth authentication, inbox UI, email details viewer, and message compose/reply.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "EiBS",
            "email": "info@eibsglobal.com"
        }
    ],
    "keywords": [
        "laravel",
        "gmail",
        "gmail-api",
        "google-api",
        "google-oauth",
        "mailbox",
        "email",
        "inbox",
        "oauth",
        "laravel-package"
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "google/apiclient": "^2.15"
    },
    "autoload": {
        "psr-4": {
            "Queen\\GmailMailbox\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Queen\\GmailMailbox\\GmailMailboxServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}